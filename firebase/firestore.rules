rules_version = '2';

// Vorläufig: alles gesperrt. Die echten Regeln (öffentliche Projektionen, Rollen je Turnier)
// kommen mit der Datenschicht. Niemals `allow write: if true`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
