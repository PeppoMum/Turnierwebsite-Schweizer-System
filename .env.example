# Firebase-Webkonfiguration (aus der Firebase-Konsole -> Projekteinstellungen -> Deine Apps).
# Diese Werte sind keine Geheimnisse, gehören aber nicht ins Repo, solange es kein festes Projekt gibt.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-turnier
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = lokale Firebase-Emulatoren statt echtem Projekt verwenden (Standard für die Entwicklung).
VITE_USE_FIREBASE_EMULATOR=true
